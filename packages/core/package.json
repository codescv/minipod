{
  "name": "@minipod/core",
  "version": "0.1.8",
  "description": "MiniPod platform-neutral core: shared types + PlatformHost contract, AntennaPod discovery searchers, pure-TS RSS/Atom/RDF/OPML/HTML parsers, binary chapter readers, CRDT cloud-file sync engine and providers. Runs unchanged in Node 22+ and browsers (no Node-only imports).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./errors": "./src/errors.ts",
    "./discovery": "./src/discovery/index.ts",
    "./feed": "./src/feed/index.ts",
    "./chapters": "./src/chapters/index.ts",
    "./http": "./src/http/index.ts",
    "./sync": "./src/sync/index.ts",
    "./queue": "./src/queue/index.ts",
    "./progress": "./src/progress/index.ts",
    "./updater": "./src/updater/index.ts",
    "./util": "./src/util/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
